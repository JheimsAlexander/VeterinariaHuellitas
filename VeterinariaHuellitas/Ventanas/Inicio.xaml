<Window x:Class="VeterinariaHuellitas.Ventanas.Inicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veterinaria Huellitas - Inicio"
        Height="760" Width="1250"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENÚ LATERAL -->
        <Border Grid.Column="0" Background="#173B35">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,30">
                    <TextBlock Text="🐾 HUELLITAS"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="SISTEMA VETERINARIO"
                               FontSize="10"
                               Foreground="#B8D9CE"
                               Margin="3,5,0,30"/>
                </StackPanel>

                <StackPanel Margin="12,0">
                    <TextBlock Text="MENÚ PRINCIPAL"
                               Foreground="#A9C9BE"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="12,10,0,12"/>

                    <Button Content="⌂    Inicio"
                            Height="45"
                            Background="#286A58"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            FontSize="15"
                            Click="btnInicio_Click"/>

                    <Button Content="♙    Registro de dueños"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            FontSize="14"
                            Click="btnDueños_Click"/>

                    <Button Content="🐾    Gestión de mascotas"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            FontSize="14"
                            Click="btnMascotas_Click"/>

                    <Button Content="▤    Historial clínico"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            FontSize="14"
                            Click="btnHistorial_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,20">
                    <Separator Background="#52776C"/>

                    <TextBlock Text="ADMINISTRADOR"
                               Foreground="#B8D9CE"
                               FontSize="11"
                               Margin="5,15,0,5"/>

                    <TextBlock Text="Sesión iniciada"
                               Foreground="White"
                               FontSize="13"/>

                    <Button Content="Cerrar sesión"
                            Height="40"
                            Margin="0,18,0,0"
                            Background="#A84444"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnCerrarSesion_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <!-- ENCABEZADO -->
                <DockPanel Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="Panel principal"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#173B35"/>

                        <TextBlock Text="Bienvenido al sistema de gestión veterinaria"
                                   FontSize="13"
                                   Foreground="#718078"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Right"
                            Background="White"
                            CornerRadius="10"
                            Padding="15,10">

                        <TextBlock Text="🐾  Administrador"
                                   Foreground="#285B4D"
                                   FontWeight="SemiBold"/>
                    </Border>
                </DockPanel>

                <!-- HERO -->
                <Border Height="260"
                        CornerRadius="18"
                        ClipToBounds="True">

                    <Grid>
                        <Image Source="/Recursos/fondo-inicio.jpg"
                               Stretch="UniformToFill"/>

                        <Border Background="#990D2924"/>

                        <StackPanel VerticalAlignment="Center"
                                    Margin="35">

                            <TextBlock Text="BIENVENIDO A"
                                       Foreground="#D5EDE3"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Veterinaria Huellitas"
                                       Foreground="White"
                                       FontSize="35"
                                       FontWeight="Bold"
                                       Margin="0,8,0,5"/>

                            <TextBlock Text="Cuidamos la salud y el bienestar de tus mejores amigos."
                                       Foreground="White"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       MaxWidth="550"/>

                            <Border Background="#27866B"
                                    CornerRadius="8"
                                    Padding="15,9"
                                    HorizontalAlignment="Left"
                                    Margin="0,20,0,0">

                                <TextBlock Text="AMOR · SALUD · CONFIANZA"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ESTADÍSTICAS -->
                <TextBlock Text="Resumen general"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#173B35"
                           Margin="0,25,0,15"/>

                <UniformGrid Columns="3">

                    <!-- DUEÑOS -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,12,0">

                        <StackPanel>
                            <TextBlock Text="👥 Dueños registrados"
                                       Foreground="#718078"
                                       FontSize="13"/>

                            <TextBlock x:Name="txtTotalDuenos"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#23866B"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- MASCOTAS -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,12,0">

                        <StackPanel>
                            <TextBlock Text="🐾 Mascotas registradas"
                                       Foreground="#718078"
                                       FontSize="13"/>

                            <TextBlock x:Name="txtTotalMascotas"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#23866B"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- CONSULTAS -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="📋 Consultas médicas"
                                       Foreground="#718078"
                                       FontSize="13"/>

                            <TextBlock x:Name="txtTotalConsultas"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#23866B"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- ACCESOS RÁPIDOS -->
                <TextBlock Text="Accesos rápidos"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#173B35"
                           Margin="0,28,0,15"/>

                <UniformGrid Columns="3">

                    <Button Content="＋  Registrar dueño"
                            Height="65"
                            Margin="0,0,12,0"
                            Background="#176B59"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="btnDueños_Click"/>

                    <Button Content="🐾  Registrar mascota"
                            Height="65"
                            Margin="0,0,12,0"
                            Background="#176B59"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="btnMascotas_Click"/>

                    <Button Content="＋  Nueva consulta"
                            Height="65"
                            Background="#176B59"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="btnHistorial_Click"/>

                </UniformGrid>

                <!-- AUTOR -->
                <TextBlock Text="Desarrollado por Jheims Alexander Mamani Quispe"
                           HorizontalAlignment="Right"
                           Foreground="#718078"
                           FontSize="11"
                           Margin="0,30,0,10"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>