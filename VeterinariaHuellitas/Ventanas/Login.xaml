<Window x:Class="VeterinariaHuellitas.Ventanas.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veterinaria Huellitas"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO -->
        <Grid Grid.Column="0" Background="#173B35">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="🐾"
                           FontSize="75"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="HUELLITAS"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Clínica Veterinaria"
                           FontSize="19"
                           Foreground="#C7E9DC"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

                <TextBlock Text="Cuidamos a quienes te dan amor."
                           FontSize="15"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,0"/>
            </StackPanel>
        </Grid>

        <!-- PANEL DERECHO -->
        <Grid Grid.Column="1">
            <StackPanel Width="330"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="Bienvenido"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#173B35"/>

                <TextBlock Text="Inicia sesión como administrador"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,8,0,30"/>

                <TextBlock Text="Usuario"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="txtUsuario"
                         Height="42"
                         FontSize="15"
                         Padding="10"
                         Margin="0,0,0,20"/>

                <TextBlock Text="Contraseña"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="txtContraseña"
                             Height="42"
                             FontSize="15"
                             Padding="10"
                             Margin="0,0,0,25"/>

                <Button Content="INICIAR SESIÓN"
                        Height="45"
                        Background="#176B59"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="btnIngresar_Click"/>

                <TextBlock Text="Desarrollado por Jheims Alexander Mamani Quispe"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="10"
                           Foreground="#64748B"
                           Margin="0,45,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>