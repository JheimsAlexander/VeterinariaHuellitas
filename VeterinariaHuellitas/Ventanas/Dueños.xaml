<Window x:Class="VeterinariaHuellitas.Ventanas.Dueños"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Clientes - Veterinaria Huellitas"
        Height="720" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F3">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Background="#173B35"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="PRINCIPAL VET"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"/>
                <TextBlock Text="VETERINARIA HUELLITAS"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="Bold"/>
                <TextBlock Text="REGISTRAR CLIENTES"
                           Foreground="#C8E8D9"
                           FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,15,0">

                <StackPanel>
                    <TextBlock Text="Datos de Cliente"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#173B35"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Código:"
                                   Grid.Row="0"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtCodigo"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Height="30"
                                 IsReadOnly="True"
                                 Background="#E9EFEC"/>

                        <TextBlock Text="Nombre:"
                                   Grid.Row="1"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtNombre"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Height="30"/>

                        <TextBlock Text="Apellido:"
                                   Grid.Row="2"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtApellido"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Height="30"/>

                        <TextBlock Text="DNI:"
                                   Grid.Row="3"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtCI"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Height="30"/>

                        <TextBlock Text="Sexo:"
                                   Grid.Row="4"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbSexo"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Height="30">
                            <ComboBoxItem Content="Masculino"/>
                            <ComboBoxItem Content="Femenino"/>
                        </ComboBox>

                        <TextBlock Text="Teléfono:"
                                   Grid.Row="5"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtTelefono"
                                 Grid.Row="5"
                                 Grid.Column="1"
                                 Height="30"/>

                        <TextBlock Text="Dirección:"
                                   Grid.Row="6"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDireccion"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Height="30"/>

                        <TextBlock Text="Correo:"
                                   Grid.Row="7"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtCorreo"
                                 Grid.Row="7"
                                 Grid.Column="1"
                                 Height="30"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PANEL DERECHO -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BÚSQUEDA -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Buscar en"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Foreground="#173B35"
                                   Margin="0,0,0,10"/>

                        <WrapPanel VerticalAlignment="Center">
                            <RadioButton x:Name="rbCodigo"
                                         Content="Código"
                                         IsChecked="True"
                                         GroupName="Busqueda"
                             Checked="rbBusqueda_Checked"
                                         Margin="0,0,15,0"/>
                            <RadioButton x:Name="rbDni"
                                         Content="DNI"
                                         GroupName="Busqueda"
                             Checked="rbBusqueda_Checked"
                                         Margin="0,0,15,0"/>
                            <RadioButton x:Name="rbNombre"
                                         Content="Nombre"
                                         GroupName="Busqueda"
                             Checked="rbBusqueda_Checked"
                                         Margin="0,0,15,0"/>
                        </WrapPanel>

                        <TextBox x:Name="txtBuscar"
                                 Height="35"
                                 Margin="0,10,0,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="txtBuscar_TextChanged"
                                 ToolTip="Escribe para buscar un dueño"/>
                    </StackPanel>

                    <!-- TABLA -->
                    <DataGrid x:Name="dgDuenos"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="dgDuenos_SelectionChanged"
                              CanUserAddRows="False"
                              CanUserResizeColumns="True"
                              AlternationCount="2"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              RowBackground="White"
                              AlternatingRowBackground="#EDF4F0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding CodigoDueño}"
                                                Width="75"/>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Apellido"
                                                Binding="{Binding ApellidoPaterno}"
                                                Width="110"/>
                            <DataGridTextColumn Header="DNI"
                                                Binding="{Binding CI}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Sexo"
                                                Binding="{Binding Sexo}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Teléfono"
                                                Binding="{Binding Telefono}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Dirección"
                                                Binding="{Binding Direccion}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Correo"
                                                Binding="{Binding Correo}"
                                                Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTONES INFERIORES -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,18,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Nuevo"
                        Width="115" Height="40"
                        Margin="5"
                        Click="btnNuevo_Click"/>

                <Button Content="Registrar"
                        Width="115" Height="40"
                        Margin="5"
                        Background="#247A59"
                        Foreground="White"
                        Click="btnGuardar_Click"/>

                <Button Content="Modificar"
                        Width="115" Height="40"
                        Margin="5"
                        Click="btnActualizar_Click"/>

                <Button Content="Eliminar"
                        Width="115" Height="40"
                        Margin="5"
                        Background="#B83A3A"
                        Foreground="White"
                        Click="btnEliminar_Click"/>

                <Button Content="Cancelar"
                        Width="115" Height="40"
                        Margin="5"
                        Click="btnCancelar_Click"/>
                <Button Content="← Volver al inicio"
        Width="150"
        Height="35"
        Click="btnVolver_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>