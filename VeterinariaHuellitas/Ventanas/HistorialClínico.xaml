<Window x:Class="VeterinariaHuellitas.Ventanas.HistorialClinico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial Clínico - Veterinaria Huellitas"
        Height="750" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0"
                Background="#164E63"
                CornerRadius="10"
                Padding="15">
            <TextBlock Text="HISTORIAL CLÍNICO - CONSULTAS MÉDICAS"
                       Foreground="White"
                       FontSize="23"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" Margin="0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- DATOS DE CONSULTA -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,10,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DATOS DE LA CONSULTA"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#164E63"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Código de consulta"/>
                        <TextBox x:Name="txtCodigo"
                                 IsReadOnly="True"
                                 Height="30"
                                 Margin="0,4,0,10"/>

                        <TextBlock Text="Fecha"/>
                        <DatePicker x:Name="dpFecha"
                                    Height="30"
                                    Margin="0,4,0,10"/>

                        <TextBlock Text="Mascota"/>
                        <ComboBox x:Name="cmbMascota"
                                  Height="32"
                                  Margin="0,4,0,10"/>

                        <TextBlock Text="Motivo de consulta"/>
                        <TextBox x:Name="txtMotivo"
                                 Height="32"
                                 Margin="0,4,0,10"/>

                        <TextBlock Text="Síntomas"/>
                        <TextBox x:Name="txtSintomas"
                                 Height="55"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,10"/>

                        <TextBlock Text="Diagnóstico"/>
                        <TextBox x:Name="txtDiagnostico"
                                 Height="55"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,10"/>

                        <TextBlock Text="Tratamiento"/>
                        <TextBox x:Name="txtTratamiento"
                                 Height="55"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,10"/>

                        <TextBlock Text="Medicamentos"/>
                        <TextBox x:Name="txtMedicamentos"
                                 Height="45"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,10"/>

                        <TextBlock Text="Observaciones"/>
                        <TextBox x:Name="txtObservaciones"
                                 Height="55"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- BUSCADOR Y TABLA -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="15">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="BUSCAR CONSULTAS MÉDICAS"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#164E63"
                                   Margin="0,0,0,12"/>

                        <TextBox x:Name="txtBuscar"
                                 Height="35"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 TextChanged="txtBuscar_TextChanged"
                                 ToolTip="Buscar por mascota, código o diagnóstico"/>
                    </StackPanel>

                    <DataGrid x:Name="dgConsultas"
                              Grid.Row="1"
                              Margin="0,15,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="dgConsultas_SelectionChanged"
                              CanUserAddRows="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código"
                                Binding="{Binding CodigoConsulta}"
                                Width="65"/>

                            <DataGridTextColumn Header="Fecha"
                                Binding="{Binding Fecha}"
                                Width="100"/>

                            <DataGridTextColumn Header="Mascota"
                                Binding="{Binding NombreMascota}"
                                Width="110"/>

                            <DataGridTextColumn Header="Motivo"
                                Binding="{Binding Motivo}"
                                Width="*"/>

                            <DataGridTextColumn Header="Diagnóstico"
                                Binding="{Binding Diagnostico}"
                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTONES -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Content="Nuevo"
                        Width="115" Height="40"
                        Margin="5"
                        Click="btnNuevo_Click"/>

                <Button Content="Registrar"
                        Width="115" Height="40"
                        Margin="5"
                        Background="#15803D"
                        Foreground="White"
                        Click="btnGuardar_Click"/>

                <Button Content="Modificar"
                        Width="115" Height="40"
                        Margin="5"
                        Click="btnActualizar_Click"/>

                <Button Content="Eliminar"
                        Width="115" Height="40"
                        Margin="5"
                        Background="#B91C1C"
                        Foreground="White"
                        Click="btnEliminar_Click"/>

                <Button Content="Cancelar"
                        Width="115" Height="40"
                        Margin="5"
                        Click="btnCancelar_Click"/>
                <Button Content=" Descargar PDF"
        Width="150"
        Height="35"
        Margin="5"
        Click="btnDescargarPDF_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>